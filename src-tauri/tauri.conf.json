{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Note-Stack",
  "version": "0.1.0",
  "identifier": "com.notestack.desktop",
  "build": {
    "frontendDist": "../desktop-frontend",
    "devUrl": "http://127.0.0.1:3001",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/assemble-desktop.mjs"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/node"],
    "resources": ["resources/app/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
