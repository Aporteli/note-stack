generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  boards      Board[]
  flashTopics FlashTopic[]
  flashFolders FlashFolder[]
  flashCards  FlashCard[]
  quizzes     Quiz[]
  quizFolders QuizFolder[]
  weekPlans   WeekPlan[]
  weekSlots   WeekSlot[]
  diagrams    Diagram[]
  createdAt   DateTime     @default(now())
}

model WeekPlan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  order     Int        @default(0)
  slots     WeekSlot[]
  createdAt DateTime   @default(now())

  @@index([userId])
}

model WeekSlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       Int
  startMin  Int
  endMin    Int
  task      String
  color     String   @default("surface")
  planId    String
  plan      WeekPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@index([userId, day])
  @@index([planId])
}

model FlashFolder {
  id        String        @id @default(cuid())
  name      String
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    FlashFolder?  @relation("FlashFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  FlashFolder[] @relation("FlashFolderTree")
  topics    FlashTopic[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, parentId])
}

model FlashTopic {
  id        String       @id @default(cuid())
  name      String
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    FlashFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  cards     FlashCard[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([folderId])
}

model Board {
  id        String     @id @default(cuid())
  title     String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists     List[]
  drawings  Drawing[]
  documents Document[]
  notes     Note[]
  links     Link[]
  arrows    Arrow[]
  headings  Heading[]
  files     BoardFile[]
  tables    BoardTable[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model List {
  id        String    @id @default(cuid())
  title     String
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  x         Float     @default(24)
  y         Float     @default(24)
  w         Float     @default(296)
  h         Float     @default(320)
  z         Int       @default(0)
  locked    Boolean   @default(false)
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String?
  image       String?
  listId      String
  list        List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  order       Int
  dueDate     DateTime?
  trashedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([listId, order])
  @@index([listId, trashedAt])
}

model Drawing {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  w         Float
  h         Float
  strokes   String
  z         Int       @default(0)
  locked    Boolean   @default(false)
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}

model FlashCard {
  id        String     @id @default(cuid())
  front     String
  back      String
  topicId   String
  topic     FlashTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, createdAt])
  @@index([topicId, createdAt])
}

model QuizFolder {
  id        String       @id @default(cuid())
  name      String
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    QuizFolder?  @relation("QuizFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  QuizFolder[] @relation("QuizFolderTree")
  quizzes   Quiz[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, parentId])
}

model Quiz {
  id        String         @id @default(cuid())
  title     String
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    QuizFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([folderId])
}

model QuizQuestion {
  id        String       @id @default(cuid())
  prompt    String
  quizId    String
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order     Int
  options   QuizOption[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([quizId, order])
}

model QuizOption {
  id         String       @id @default(cuid())
  text       String
  correct    Boolean      @default(false)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int

  @@index([questionId, order])
}

model Document {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String    @default("Untitled")
  content   String    @default("{\"text\":\"\",\"strokes\":[]}")
  x         Float
  y         Float
  z         Int       @default(0)
  locked    Boolean   @default(false)
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}

model Link {
  id          String    @id @default(cuid())
  boardId     String
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  url         String    @default("")
  title       String    @default("")
  description String    @default("")
  image       String    @default("")
  icon        String    @default("")
  x           Float
  y           Float
  w           Float     @default(300)
  h           Float     @default(48)
  trashedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}

model Arrow {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  x1        Float
  y1        Float
  x2        Float
  y2        Float
  fromType  String    @default("")
  fromId    String    @default("")
  fromSide  String    @default("")
  toType    String    @default("")
  toId      String    @default("")
  toSide    String    @default("")
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}

model BoardFile {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  mime      String    @default("")
  size      BigInt    @default(0)
  kind      String    @default("file")
  x         Float
  y         Float
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}

model BoardTable {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  cols      Int       @default(4)
  rows      Int       @default(7)
  cells     String    @default("{}")
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}

model Heading {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  text      String    @default("")
  x         Float
  y         Float
  w         Float     @default(640)
  h         Float     @default(96)
  z         Int       @default(0)
  locked    Boolean   @default(false)
  fontSize  Int       @default(28)
  color     String    @default("#1e293b")
  bold      Boolean   @default(false)
  align     String    @default("center")
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}

model Diagram {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled diagram")
  document  String   @default("{\"shapes\":[],\"connectors\":[]}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Note {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  text      String    @default("")
  x         Float
  y         Float
  w         Float     @default(320)
  h         Float     @default(320)
  z         Int       @default(0)
  locked    Boolean   @default(false)
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}