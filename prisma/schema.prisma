generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  boards      Board[]
  flashTopics FlashTopic[]
  flashCards  FlashCard[]
  createdAt   DateTime     @default(now())
}

model FlashTopic {
  id        String      @id @default(cuid())
  name      String
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     FlashCard[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId, createdAt])
}

model Board {
  id        String     @id @default(cuid())
  title     String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists     List[]
  drawings  Drawing[]
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model List {
  id        String    @id @default(cuid())
  title     String
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  x         Float     @default(24)
  y         Float     @default(24)
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String?
  listId      String
  list        List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  order       Int
  dueDate     DateTime?
  trashedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([listId, order])
  @@index([listId, trashedAt])
}

model Drawing {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  w         Float
  h         Float
  strokes   String
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}

model FlashCard {
  id        String     @id @default(cuid())
  front     String
  back      String
  topicId   String
  topic     FlashTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, createdAt])
  @@index([topicId, createdAt])
}

model Document {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String    @default("Untitled")
  content   String    @default("{\"text\":\"\",\"strokes\":[]}")
  x         Float
  y         Float
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([boardId, trashedAt])
}